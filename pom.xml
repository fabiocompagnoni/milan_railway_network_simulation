<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>it.unimib</groupId>
    <artifactId>milan-suburban-railsim</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Milan Suburban Railway Simulation</name>
    <description>Simulazione della rete suburbana (linee S) di Milano basata su railsim/MATSim</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>
        <matsim.version>2027.0-SNAPSHOT</matsim.version>
        <javafx.version>26.0.2</javafx.version>
        <exec.mainClass>it.unimib.milanrailsim.RunMilanRailsim</exec.mainClass>
        <gui.mainClass>it.unimib.milanrailsim.gui.app.Launcher</gui.mainClass>
        <!-- jpackage refuses -SNAPSHOT: the packaged application carries the plain version -->
        <dist.version>0.1.0</dist.version>
        <dist.input>${project.build.directory}/dist/input</dist.input>
    </properties>

    <!-- Repository che ospitano le dipendenze transitive di MATSim (geotools, jogl, ecc.).
         Gli artifact matsim/railsim 2027.0-SNAPSHOT sono gia' in ~/.m2 (mvn install locale). -->
    <repositories>
        <repository>
            <id>matsim</id>
            <url>https://repo.matsim.org/repository/matsim/</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
        <repository>
            <id>jogl</id>
            <url>https://jogamp.org/deployment/maven/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.matsim</groupId>
            <artifactId>matsim</artifactId>
            <version>${matsim.version}</version>
        </dependency>
        <dependency>
            <groupId>ch.sbb.matsim.contrib</groupId>
            <artifactId>railsim</artifactId>
            <version>${matsim.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>2.22.2</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>2.22.2</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-javafx</artifactId>
            <version>12.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.kordamp.ikonli</groupId>
            <artifactId>ikonli-material2-pack</artifactId>
            <version>12.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>1.5.6</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <!-- Consente: mvn exec:java  (usa exec.mainClass) -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.6</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.5.1</version>
            </plugin>
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>${gui.mainClass}</mainClass>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>milan-railsim-gui</finalName>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${gui.mainClass}</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>dist</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>stage-dist</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <outputDirectory>${dist.input}</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>milan-railsim-gui.jar</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>scenarios/milan</directory>
                                            <targetPath>share/scenarios/milan</targetPath>
                                            <includes>
                                                <include>config.xml</include>
                                                <include>network-with-stations.xml</include>
                                                <include>network-micro.xml</include>
                                                <include>transitSchedule.xml</include>
                                                <include>link-geometry.csv</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>data/nodes</directory>
                                            <targetPath>share/data/nodes</targetPath>
                                        </resource>
                                        <resource>
                                            <directory>data/osm/2026-08-05-network-sweep</directory>
                                            <targetPath>share/data/osm/2026-08-05-network-sweep</targetPath>
                                            <includes>
                                                <include>link_measures.csv</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>orari_trenord</directory>
                                            <targetPath>share/orari_trenord</targetPath>
                                            <includes>
                                                <include>*.txt</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>docs/network/misure</directory>
                                            <targetPath>share/docs/network/misure</targetPath>
                                            <includes>
                                                <include>binari-stazioni.csv</include>
                                            </includes>
                                        </resource>
                                        <resource>
                                            <directory>config</directory>
                                            <targetPath>share/config</targetPath>
                                            <includes>
                                                <include>costs.json</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>jpackage</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--type</argument>
                                        <argument>${dist.type}</argument>
                                        <argument>--input</argument>
                                        <argument>${dist.input}</argument>
                                        <argument>--main-jar</argument>
                                        <argument>milan-railsim-gui.jar</argument>
                                        <argument>--main-class</argument>
                                        <argument>${gui.mainClass}</argument>
                                        <argument>--name</argument>
                                        <argument>MilanRailSim</argument>
                                        <argument>--app-version</argument>
                                        <argument>${dist.version}</argument>
                                        <argument>--vendor</argument>
                                        <argument>Fabio Compagnoni, Università di Milano-Bicocca</argument>
                                        <argument>--description</argument>
                                        <argument>Simulatore della rete ferroviaria suburbana di Milano</argument>
                                        <argument>--icon</argument>
                                        <argument>${dist.icon}</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dmilanrailsim.data=$APPDIR/share</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/dist</argument>
                                        <argument>--resource-dir</argument>
                                        <argument>assets/jpackage/${dist.platform}</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>dist-linux</id>
            <activation>
                <os>
                    <family>unix</family>
                    <name>Linux</name>
                </os>
            </activation>
            <properties>
                <dist.platform>linux</dist.platform>
                <dist.type>deb</dist.type>
                <dist.icon>src/main/resources/it/unimib/milanrailsim/gui/images/logo.png</dist.icon>
            </properties>
        </profile>
        <profile>
            <id>dist-windows</id>
            <activation>
                <os>
                    <family>windows</family>
                </os>
            </activation>
            <properties>
                <dist.platform>windows</dist.platform>
                <dist.type>exe</dist.type>
                <dist.icon>assets/logo/logo.ico</dist.icon>
            </properties>
        </profile>
        <profile>
            <id>dist-mac</id>
            <activation>
                <os>
                    <family>mac</family>
                </os>
            </activation>
            <properties>
                <dist.platform>mac</dist.platform>
                <dist.type>dmg</dist.type>
                <dist.icon>assets/logo/logo.icns</dist.icon>
            </properties>
        </profile>
    </profiles>
</project>